{
  "appId": "com.elifaplatform.mushaf",
  "appName": "Elifa Mushaf",
  "webDir": "ios-www",
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["apple.com", "google.com"]
    }
